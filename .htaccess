AddDefaultCharset UTF-8

# Отключаем ETag (ускоряет повторную загрузку, убирая лишние запросы 304)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

RewriteEngine On
RewriteBase /

# 1. Постраничные редиректы
Redirect 301 /page/8 https://stroikomcompany.ru/index
Redirect 301 /page/1 https://stroikomcompany.ru/construction_repair
Redirect 301 /page/2 https://stroikomcompany.ru/construction_repair
